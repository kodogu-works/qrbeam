{
  "name": "qrbeam",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Secure offline file transfer via QR codes",
  "author": "Synge Todo",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "npm run build && playwright test",
    "check": "npm run typecheck && npm test && npm run build && node scripts/check-artifact.mjs",
    "benchmark": "tsx scripts/benchmark.ts",
    "verify": "node scripts/check-artifact.mjs"
  },
  "dependencies": {
    "jsqr": "1.4.0",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.19.0",
    "@types/qrcode": "1.5.5",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "5.7.2",
    "vitest": "4.1.12"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents": false
  }
}
